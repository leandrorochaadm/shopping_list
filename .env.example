# The hosted Supabase project. Copy to .env and fill in -- .env is git-ignored.
#
#   cp .env.example .env
#
# There is no `dev` project yet (see docs/pendencias-lista-de-compras.md, A1),
# so these point at `prod`. When `dev` is born, this file gains a second pair.

# Passed to the app as --dart-define. Without both, a debug build falls back to
# the fakes and shows the DADOS FAKE banner.
SUPABASE_URL=https://sxwyundsrbvbmmacgngs.supabase.co
SUPABASE_ANON_KEY=

# Only for tool/checks.sh, which runs supabase/checks/*.sql. The app never
# reads it. The dashboard does not show this password after the project is
# created -- Settings -> Database -> Reset database password is the way back.
# ALWAYS single-quoted: tool/checks.sh reads this file with `source`, and a
# `;`, `$`, `#` or space in the password is eaten by the shell -- the value
# reaches psql truncated and the error says "password authentication failed",
# which sends you looking in the wrong place. It already happened once.
SUPABASE_DB_PASSWORD=''

# Optional. Direct connection to the hosted database is IPv6-only; on a network
# without IPv6, copy the session pooler host from the dashboard (Connect) into
# these three. Empty means direct.
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=

# The project ref, so scripts do not repeat it.
SUPABASE_PROJECT_REF=sxwyundsrbvbmmacgngs
