#!/usr/bin/env python3
"""Formats the staged Dart files before every commit.

The line width (120) lives in `analysis_options.yaml` (`formatter: page_width`),
so the hook, the IDE and a hand-run `dart format` all agree.

A file staged in full is formatted and staged again. A file with unstaged
changes on top is only checked: re-staging it would sweep those changes into
the commit, so the commit stops and asks for `dart format <file>` instead.
"""

import shutil
import subprocess
import sys


def out(*args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout.splitlines()


def main():
    # The hook also runs from an IDE, where the login shell's PATH is not loaded.
    if shutil.which('dart') is None:
        print('pre-commit: dart is not on the PATH, skipping the format', file=sys.stderr)
        return 0

    staged = [f for f in out('git', 'diff', '--cached', '--name-only', '--diff-filter=ACMR') if f.endswith('.dart')]
    if not staged:
        return 0

    unstaged = set(out('git', 'diff', '--name-only'))
    partial = [f for f in staged if f in unstaged]
    full = [f for f in staged if f not in unstaged]

    if full:
        subprocess.run(['dart', 'format', *full], check=True, capture_output=True)
        subprocess.run(['git', 'add', *full], check=True)

    if partial:
        check = subprocess.run(['dart', 'format', '--output=none', '--set-exit-if-changed', *partial])
        if check.returncode != 0:
            print('pre-commit: partly staged files need formatting; run dart format on them and stage again.',
                  file=sys.stderr)
            return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
