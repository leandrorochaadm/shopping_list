# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Scratch: implementation plans and diagrams, not part of the deliverable
/temp/

# Credentials: the hosted project's URL and anon key, plus the database
# password used to run supabase/checks/ by hand. Never committed -- they enter
# the build by --dart-define and the CI by GitHub secrets. The example file IS
# committed, and is the only place the variable names are written down.
/.env
/.env.*
!/.env.example

# Local override that points tekton_core at the clone next door — never committed.
pubspec_overrides.yaml
